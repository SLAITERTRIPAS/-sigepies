{
  "entities": {
    "User": {
      "title": "User",
      "description": "Utilizador do sistema SIGEP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Administrador", "Visualizador", "Editor"] },
        "cargo": { "type": "string" },
        "instituicaoId": { "type": "string" },
        "tenantId": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Institution": {
      "title": "Institution",
      "description": "Dados da instituição proprietária do sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "sigla": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["nome"]
    },
    "Expediente": {
      "title": "Expediente",
      "description": "Documento em tramitação no sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "assunto": { "type": "string" },
        "status": { "type": "string" },
        "historico": { "type": "array" },
        "tenantId": { "type": "string" }
      },
      "required": ["numero", "assunto", "status"]
    },
    "SystemAlert": {
      "title": "SystemAlert",
      "description": "Alerta ou comunicado do sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["crítico", "aviso", "feriado", "info"] },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["title", "message", "type", "isActive"]
    },
    "Signature": {
      "title": "Signature",
      "description": "Assinatura digital de um utilizador",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "data": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção de perfis de utilizadores"
    },
    "/instituicoes/{instId}": {
      "schema": "Institution",
      "description": "Coleção de dados institucionais"
    },
    "/expedientes/{expId}": {
      "schema": "Expediente",
      "description": "Coleção de expedientes"
    },
    "/system_alerts/{alertId}": {
      "schema": "SystemAlert",
      "description": "Coleção de alertas do sistema"
    },
    "/signatures/{sigId}": {
      "schema": "Signature",
      "description": "Coleção de assinaturas digitais"
    },
    "/config_sistema/{docId}": {
      "schema": "object",
      "description": "Configurações gerais do sistema"
    },
    "/colaboradores/{colabId}": {
      "schema": "object",
      "description": "Coleção de colaboradores"
    },
    "/processos_individuais/{procId}": {
      "schema": "object",
      "description": "Coleção de processos individuais"
    },
    "/matrix_activities/{actId}": {
      "schema": "object",
      "description": "Coleção de planos de atividades"
    },
    "/auditLogs/{logId}": {
      "schema": "object",
      "description": "Logs de auditoria"
    }
  }
}
