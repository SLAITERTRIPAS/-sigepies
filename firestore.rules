rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- PRIMITIVOS GLOBAIS ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Verificação de Roles baseada na coleção de utilizadores
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == "Administrador" || 
        request.auth.token.email == "slaitertripas@gmail.com" ||
        request.auth.token.email == "fttripas@gmail.com"
      );
    }

    // --- SEGURANÇA POR OMISSÃO ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- COLEÇÕES ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      match /sessions/{sessionId} {
        allow read, write: if isSignedIn();
      }
    }

    match /instituicoes/{instId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /expedientes/{expId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /system_alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /signatures/{sigId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /config_sistema/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /colaboradores/{colabId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // HR Boss logic can be added later
    }

    match /processos_individuais/{procId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /matrix_activities/{actId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /actividades/{actId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /plano_actividades/{actId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    
    match /messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (incoming().toUid == request.auth.uid || incoming().fromUid == request.auth.uid);
    }

    match /sector_menu_configs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Compatibilidade com mapeamentos antigos
    match /matrixActivities/{id} { allow read, write: if isSignedIn(); }
    match /archive_documents/{id} { allow read, write: if isSignedIn(); }
    match /library_books/{id} { allow read, write: if isSignedIn(); }
    match /library_visits/{id} { allow read, write: if isSignedIn(); }
    match /financial_data/{id} { allow read, write: if isSignedIn(); }
    match /materiais_bens/{id} { allow read, write: if isSignedIn(); }
    match /suppliers/{id} { allow read, write: if isSignedIn(); }
    match /efetivo_escolar/{id} { allow read, write: if isSignedIn(); }
    match /service_requests/{id} { allow read, write: if isSignedIn(); }
    match /sector_menu_configs/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
  }
}
