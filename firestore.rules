rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. FUNÇÕES AUXILIARES GLOBAIS ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Obtém dados do perfil do utilizador autenticado de forma ultra-segura
    function getUserData() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Evitamos erro se o documento não existir
      return exists(userPath) ? get(userPath).data : null;
    }
    
    function isMasterEmail() {
      return request.auth.token.email == 'slaitertripas@gmail.com' || request.auth.token.email == 'fttripas@gmail.com';
    }

    // Verificação de Administrador Global (Soberano)
    function isGlobalAdmin() {
      return isSignedIn() && (
        isMasterEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador Global do Sistema'))
      );
    }

    // Verificação de Administrador Institucional
    function isInstAdmin() {
      let user = getUserData();
      return isSignedIn() && user != null && (
        user.role == 'Administrador' || 
        (user.cargoChefia != null && user.cargoChefia.lower().contains('administrador'))
      );
    }

    // Verificação de Pertença à Instituição (Multi-tenancy)
    function sameInstitution() {
      let user = getUserData();
      return isSignedIn() && user != null && (resource == null || resource.data.instituicaoId == user.instituicaoId || resource.data.tenantId == user.instituicaoId);
    }

    function incomingSameInstitution() {
      let user = getUserData();
      return isSignedIn() && user != null && (incoming().instituicaoId == user.instituicaoId || incoming().tenantId == user.instituicaoId);
    }

    // --- 2. REGRAS POR CATEGORIA DE COLECÇÃO ---

    // SEGURANÇA POR OMISSÃO (Soberania do Admin Global)
    match /{document=**} {
      allow read, write: if isGlobalAdmin();
    }

    // A: GESTÃO DE UTILIZADORES E PERFIS
    match /users/{userId} {
      allow read: if isSignedIn(); // Necessário para verifyUser e syncUserPassword
      allow create: if isSignedIn() || isGlobalAdmin(); 
      allow update: if isGlobalAdmin() || 
                    isOwner(userId) || 
                    (isSignedIn() && existing().uid == request.auth.uid) ||
                    isMasterEmail() ||
                    (isSignedIn() && (existing().email == incoming().email || existing().nuit == incoming().nuit)) ||
                    (isInstAdmin() && sameInstitution());
      allow delete: if isGlobalAdmin();
    }

    match /sessions/{userId} {
      allow read, write: if isOwner(userId) || isGlobalAdmin();
    }

    match /password_reset_requests/{requestId} {
      allow create: if true;
      allow read, write: if isGlobalAdmin();
    }

    // B: RECURSOS HUMANOS (COLABORADORES)
    match /colaboradores/{colabId} {
      allow read: if isSignedIn(); // Necessário para busca exaustiva no login
      allow write: if isGlobalAdmin() || 
                   (isInstAdmin() && incomingSameInstitution()) ||
                   (isSignedIn() && (existing().userId == request.auth.uid || existing().uid == request.auth.uid || incoming().userId == request.auth.uid || incoming().uid == request.auth.uid)) ||
                   (isSignedIn() && (existing().email == incoming().email || existing().nuit == incoming().nuit)) ||
                   (isSignedIn() && (existing().email == request.auth.token.email || incoming().email == request.auth.token.email));
    }

    // C: OPERAÇÕES INSTITUCIONAIS (PLANEAMENTO, ACADÉMICO, FINANCEIRO, LOGÍSTICA)
    match /{path}/{docId} {
      allow read: if isSignedIn() && (
        isGlobalAdmin() || 
        sameInstitution() ||
        path in ["instituicoes", "config_sistema", "documentos_normativos"]
      );
      
      allow write: if isSignedIn() && (
        isGlobalAdmin() || 
        (isInstAdmin() && incomingSameInstitution()) ||
        (path in ["notes", "messages", "drafts", "signatures", "notifications"] && (existing().userId == request.auth.uid || incoming().userId == request.auth.uid))
      );

      function isOperational() {
        return path in [
          "actividades", "matrixActivities", "matrix_activities", "plano_actividades",
          "plan_schedules", "calendar_events", "service_requests", "archive_documents",
          "archiveDocuments", "bolsas", "financial_data", "materiais_bens", "suppliers",
          "library_visits", "library_books", "accessAlerts", "processos", "processos_individuais",
          "monografia", "graduados", "reports", "institucional_plans", "efetivo_escolar",
          "alunos", "matriculas", "alocacoes_docentes", "turmas", "disciplinas_academicas",
          "espacos_fisicos", "exames", "atendimentos_estudantis", "colaboradores_formacao",
          "assiduidade", "movimentos_economato", "inventarios_patrimoniais", "requisicoes_internas",
          "tetos_orcamentais", "produtos_unificados", "balanco_config", "patrimonio_itens",
          "attendance_logs", "direcoes_organicas", "estrutura_adicionais", "orgaos_custom",
          "direcoes_excluidas", "systemReminders", "holiday_requests", "feedback", "expedientes"
        ];
      }
      
      allow read: if isOperational() && (isGlobalAdmin() || sameInstitution());
      allow write: if isOperational() && (isGlobalAdmin() || (isSignedIn() && (sameInstitution() || incomingSameInstitution())));
    }

    // D: PRIVACIDADE DO UTILIZADOR
    match /notes/{id} { allow read, write: if isOwner(existing().userId) || isOwner(incoming().userId) || isGlobalAdmin(); }
    match /messages/{id} { 
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isGlobalAdmin());
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }
    match /drafts/{id} { allow read, write: if isOwner(existing().userId) || isOwner(incoming().userId) || isGlobalAdmin(); }
    match /notifications/{id} { allow read, write: if isOwner(existing().userId) || isOwner(incoming().userId) || isGlobalAdmin(); }

    // E: AUDITORIA E LOGS
    match /auditLogs/{id} {
      allow read: if isGlobalAdmin() || isInstAdmin();
      allow create: if isSignedIn();
    }
    match /system_logs/{id} { allow read, write: if isGlobalAdmin(); }
    match /system_alerts/{id} { allow read: if isSignedIn(); allow write: if isGlobalAdmin(); }
    match /system_backups/{id} { allow read, write: if isGlobalAdmin(); }
  }
}
